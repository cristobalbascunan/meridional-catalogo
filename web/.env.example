# Copiar a `.env` y rellenar. Vite sólo expone al navegador las variables que
# empiezan por VITE_.

# Endpoint al que se envía el formulario de presupuesto. Vale cualquier servicio
# que acepte un POST con JSON: Formspree, Netlify Forms, Basin, Formcarry…
# Mientras esté vacío, «Enviar solicitud» abre el correo del visitante con la
# solicitud ya redactada en lugar de fingir un envío.
VITE_FORM_ENDPOINT=

# Dominio público, sin barra final. Lo usan las URL canónicas, la imagen de
# Open Graph y el sitemap, que tienen que ser absolutas.
VITE_SITE_URL=https://www.meridionalplastic.com
